{
  "name": "@putianyi888/vue3-plots",
  "version": "0.6.0",
  "description": "Composable Vue 3 SVG plot layers for building charts from small, focused components.",
  "type": "module",
  "license": "MIT",
  "author": "Tianyi Pu",
  "homepage": "https://putianyi889.github.io/vue3-plots/",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/putianyi889/vue3-plots.git"
  },
  "bugs": {
    "url": "https://github.com/putianyi889/vue3-plots/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "plots",
    "charts",
    "svg",
    "data-visualization"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/vue3-plots.umd.cjs",
  "module": "./dist/vue3-plots.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-plots.js",
      "require": "./dist/vue3-plots.umd.cjs"
    },
    "./style.css": "./dist/vue3-plots.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "docs:components": "node scripts/update-component-docs.mjs",
    "docs:ts": "typedoc --options typedoc.json",
    "docs:api": "npm run docs:components && npm run docs:ts",
    "docs:api:watch": "node scripts/watch-docs-api.mjs",
    "docs:dev": "node scripts/dev-docs.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/language-core": "^3.1.8",
    "@vue/test-utils": "^2.4.0",
    "@vueuse/core": "^14.3.0",
    "chokidar": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue": "^3.5.0",
    "vue-component-meta": "^3.3.5",
    "vue-tippy": "^6.7.1",
    "vue-tsc": "^3.3.4"
  }
}
